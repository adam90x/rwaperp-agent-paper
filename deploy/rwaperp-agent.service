[Unit]
Description=RWAPerp Agent FINAL - PAPER
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/opt/rwaperp-agent
ExecStart=/opt/rwaperp-agent/.venv/bin/python /opt/rwaperp-agent/agent.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rwaperp-agent

[Install]
WantedBy=multi-user.target
